{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-archive-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-archive-prod",
      "database_id": "9b9b6d95-0d2b-4dec-9068-0c8be7a4be2d",
      "migrations_dir": "../../packages/database/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "personal-archive-media"
    }
  ],
  "assets": {
    "directory": "../../apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    {
      "pattern": "feonzmeko.qzz.io",
      "custom_domain": true
    },
    {
      "pattern": "www.feonzmeko.qzz.io",
      "custom_domain": true
    },
    {
      "pattern": "origin.feonzmeko.qzz.io",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "R2_BUCKET_NAME": "personal-archive-media",
    "R2_REGION": "auto",
    "R2_PUBLIC_DOMAIN": "https://media.feonzmeko.qzz.io",
    "JWT_SECRET": "personal-archive-jwt-secret-dev-placeholder"
  }
}
