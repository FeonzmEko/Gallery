{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-archive-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal_archive_db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/database/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "personal-archive-media"
    }
  ],
  "assets": {
    "directory": "../../apps/web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ENVIRONMENT": "development",
    "R2_BUCKET_NAME": "personal-archive-media",
    "R2_REGION": "auto",
    "JWT_SECRET": "personal-archive-jwt-secret-dev-placeholder"
  }
}
