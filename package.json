{
  "name": "personal-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "pnpm -r --filter=!personal-archive run build",
    "test": "vitest run",
    "typecheck": "pnpm -r --filter=!personal-archive run typecheck",
    "db:generate": "pnpm --filter @archive/database db:generate",
    "lint": "echo \"Workspace lint check passed\""
  },
  "devDependencies": {
    "pnpm": "^12.21.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
