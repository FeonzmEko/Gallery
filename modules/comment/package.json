{
  "name": "@archive/module-comment",
  "version": "0.1.0",
  "description": "Comment module contract and reserved schema for Personal Archive",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/infrastructure/schema.ts",
      "import": "./src/infrastructure/schema.ts",
      "default": "./src/infrastructure/schema.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@archive/contracts": "workspace:*",
    "@archive/shared": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
