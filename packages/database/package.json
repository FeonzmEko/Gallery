{
  "name": "@archive/database",
  "version": "0.1.0",
  "description": "Unified database models, D1 AtomicBatch abstraction, and Drizzle migrations",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./batch": {
      "types": "./src/batch.ts",
      "import": "./src/batch.ts",
      "default": "./src/batch.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts",
      "default": "./src/schema.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@archive/contracts": "workspace:*",
    "@archive/shared": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
