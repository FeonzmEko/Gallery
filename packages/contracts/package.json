{
  "name": "@archive/contracts",
  "version": "0.1.0",
  "description": "Shared contract definitions, ports, DTOs, and event contracts for Personal Archive",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ports": {
      "types": "./src/ports/index.ts",
      "import": "./src/ports/index.ts",
      "default": "./src/ports/index.ts"
    },
    "./models": {
      "types": "./src/models/index.ts",
      "import": "./src/models/index.ts",
      "default": "./src/models/index.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "import": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    },
    "./errors": {
      "types": "./src/errors/index.ts",
      "import": "./src/errors/index.ts",
      "default": "./src/errors/index.ts"
    },
    "./events": {
      "types": "./src/events/index.ts",
      "import": "./src/events/index.ts",
      "default": "./src/events/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
